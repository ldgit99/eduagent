[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ role }}"
requires-python = ">=3.12"
dependencies = ["{{ harness }}"]

[project.scripts]
{{ slug }} = "app.agent:main"

[project.optional-dependencies]
dev = ["pytest>=8.3"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
