[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ role }}"
requires-python = ">=3.12"
dependencies = [
  "{{ harness }}",
  "fastapi>=0.115",
  "uvicorn[standard]>=0.32",
]

[project.optional-dependencies]
dev = ["pytest>=8.3", "httpx>=0.27"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
